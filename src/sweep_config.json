{
    "name": "hparam_bayes_ablation",
    "method": "bayes",
    "metric": {
        "name": "best_val_loss",
        "goal": "minimize"
    },
    "parameters": {
        "learningRate": {
            "distribution": "log_uniform_values",
            "min": 0.0001,
            "max": 0.001
        },
        "weightDecay": {
            "values": [0.01, 0.05, 0.1, 0.2, 0.3]
        },
        "smoothL1Beta": {
            "values": [5.0, 10.0, 20.0, 50.0]
        },
        "batchSize": {
            "values": [32, 64, 128]
        },
        "attnDim": {
            "values": [16, 32]
        },
        "numHeads": {
            "value": 8
        },
        "warmupRatio": {
            "values": [0.03, 0.08]
        },
        "decayRatio": {
            "values": [0.07, 0.15]
        },
        "minLrRatio": {
            "values": [0.0, 0.01, 0.05]
        },
        "maxGradNorm": {
            "values": [1.0, 5.0, 10.0]
        },
        "epochs": {
            "value": 25
        }
    }
}
